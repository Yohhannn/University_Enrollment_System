<!-- Add this CSS in your head or stylesheet -->
<style>
    .sidebar {
        background: linear-gradient(135deg, #2c3e50, #3498db);
        min-height: 100vh;
        width: 250px;
        padding: 20px 0;
        box-shadow: 2px 0 10px rgba(0,0,0,0.1);
    }
    .sidebar-brand {
        color: white;
        font-size: 1.5rem;
        padding: 0 20px 20px;
        margin-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
    }
    .sidebar-nav {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .nav-item {
        margin-bottom: 5px;
    }
    .nav-link {
        color: rgba(255,255,255,0.8);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        text-decoration: none;
        transition: all 0.3s;
        border-left: 3px solid transparent;
    }
    .nav-link:hover {
        color: white;
        background: rgba(255,255,255,0.1);
        border-left: 3px solid #f39c12;
    }
    .nav-link.active {
        color: white;
        background: rgba(255,255,255,0.2);
        border-left: 3px solid #f39c12;
        font-weight: 500;
    }
    .nav-link i {
        margin-right: 10px;
        width: 20px;
        text-align: center;
    }
    .logout-link {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,0.1);
    }
</style>

<!-- Add this HTML where you want the sidebar -->
<div class="sidebar">
    <div class="sidebar-brand">
        <i class="fas fa-graduation-cap me-3"></i>
        <span>Student System</span>
    </div>

    <ul class="sidebar-nav">
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")"
               href="@Url.Action("MainHome", "Main")">
                <i class="fas fa-home"></i>
                <span>Home</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "StudentProfile" ? "active" : "")"
               href="@Url.Action("Student_Profile", "Main")">
                <i class="fas fa-user"></i>
                <span>Profile</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "StudentEnroll" ? "active" : "")"
               href="@Url.Action("Student_Enrollment", "StudentEnrollment")">
                <i class="fas fa-clipboard-list"></i>
                <span>Enrollment</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "ClassSchedule" ? "active" : "")"
               href="@Url.Action("Student_Schedule", "Main")">
                <i class="fas fa-calendar-alt"></i>
                <span>Schedule</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "ViewGrades" ? "active" : "")"
               href="@Url.Action("Student_Grade", "Main")">
                <i class="fas fa-chart-bar"></i>
                <span>Grades</span>
            </a>
        </li>
        <li class="nav-item logout-link">
            <a class="nav-link" href="@Url.Action("Login", "Login")">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </li>
    </ul>
</div>

<!-- Don't forget to include Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">